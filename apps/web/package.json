{
  "name": "@sukushow/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "icons": "node scripts/generate-ui-icons.mjs",
    "build": "node scripts/generate-ui-icons.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:pwa": "pnpm build && playwright test --config playwright.pwa.config.ts"
  },
  "dependencies": {
    "@sukushow/chart": "workspace:*",
    "@sukushow/chart-svg": "workspace:*",
    "@sukushow/export": "workspace:*",
    "@sukushow/llll-preview": "workspace:*",
    "@sukushow/pjsk-preview": "workspace:*"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.146",
    "@playwright/test": "^1.58.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
