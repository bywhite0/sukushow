  },
  "dependencies": {
    "@sukushow/chart": "workspace:*",
    "@sukushow/export": "workspace:*",
    "@sukushow/llll-preview": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
